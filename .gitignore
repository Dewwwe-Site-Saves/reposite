.DS_Store
node_modules

# VS Code: only the shared workspace settings are versioned
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/cspell.json

# Claude Code: project settings are shared, local overrides are not
.claude/settings.local.json

# Next.js / TypeScript
.next
out
tsconfig.tsbuildinfo
# Regenerated by every next dev / next build, and each writes a different path into it
next-env.d.ts

# Environment
.env
.env.*
!.env.example

# Runtime data: SQLite database, site clones, certificates (all under DATA_DIR)
/data
/files
/sp-certificates
/prisma/*.db*
/lib/generated

# Legacy v1 artifacts, kept ignored so an old copy never gets committed
config.json
config.txt
.dewwwe-backup-token*
