{
    "name": "reposite",
    "version": "3.0.1",
    "description": "Self-hosted backup manager for WordPress websites: files over FTP/SFTP, database dump, versioned in GitHub",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "postinstall": "prisma generate",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:studio": "prisma studio",
        "import:config": "tsx scripts/import-config.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Dewwwe-Site-Saves/reposite.git"
    },
    "keywords": [
        "node",
        "npm",
        "javascript",
        "save",
        "wordpress",
        "database",
        "github"
    ],
    "author": "Dewwwe Site Saves",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/Dewwwe-Site-Saves/reposite/issues"
    },
    "homepage": "https://github.com/Dewwwe-Site-Saves/reposite#readme",
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@hugeicons/core-free-icons": "^4.4.0",
        "@hugeicons/react": "^1.1.10",
        "@pnp/nodejs": "^4.23.0",
        "@pnp/sp": "^4.21.0",
        "@prisma/adapter-better-sqlite3": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "basic-ftp": "^6.2.6",
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "^13.1.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cronstrue": "^3.39.0",
        "jose": "^6.2.17",
        "next": "^16.4.6",
        "node-cron": "^4.6.0",
        "nodemailer": "^10.5.0",
        "prisma": "^7.10.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "ssh2-sftp-client": "^9.1.0",
        "tailwind-merge": "^3.7.0",
        "tsx": "^4.23.15",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.6.7"
    },
    "type": "module",
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.5",
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^26.6.6",
        "@types/nodemailer": "^8.0.2",
        "@types/react": "^19.3.0",
        "@types/ssh2-sftp-client": "^9.0.6",
        "postcss": "^8.5.32",
        "prettier": "^3.10.1",
        "shadcn": "^4.23.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    }
}
